PORT=5000
NODE_ENV=development
DATABASE_URL="mysql://your_db_user:your_db_password@localhost:3306/bookleaf_support_portal"
JWT_SECRET="replace_with_a_long_random_secure_secret_in_production"
JWT_EXPIRES_IN="7d"

# OpenAI Configuration (leave OPENAI_API_KEY empty and set AI_MOCK_MODE=true for offline mock mode)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
AI_MOCK_MODE="true"
AI_TIMEOUT_MS=10000

# CORS Allowed Origin
FRONTEND_URL="http://localhost:5173"
