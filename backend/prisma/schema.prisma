datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  AUTHOR
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketCategory {
  ROYALTY_AND_PAYMENTS
  ISBN_AND_METADATA
  PRINTING_AND_QUALITY
  DISTRIBUTION_AND_AVAILABILITY
  BOOK_STATUS_AND_PRODUCTION
  GENERAL_INQUIRY
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String
  role            Role           @default(AUTHOR)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  authorProfile   AuthorProfile?
  sentMessages    TicketMessage[]
  assignedTickets Ticket[]       @relation("AssignedAdmin")

  @@index([role])
}

model AuthorProfile {
  id          String   @id @default(uuid())
  authorCode  String   @unique // e.g. AUTH001
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  city        String?
  joinedDate  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books       Book[]
  tickets     Ticket[]

  @@index([name])
}

model Book {
  id                    String    @id @default(uuid())
  bookCode              String    @unique // e.g. BK001
  authorId              String
  author                AuthorProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title                 String
  isbn                  String
  genre                 String
  publicationDate       DateTime? // Nullable for books in production
  status                String    // "Published & Live", "In Production - Cover Design", etc.
  mrp                   Decimal?  @db.Decimal(10, 2)
  authorRoyaltyPerCopy  Decimal?  @db.Decimal(10, 2)
  totalCopiesSold       Int       @default(0)
  totalRoyaltyEarned    Decimal   @default(0.00) @db.Decimal(12, 2)
  royaltyPaid           Decimal   @default(0.00) @db.Decimal(12, 2)
  royaltyPending        Decimal   @default(0.00) @db.Decimal(12, 2)
  lastRoyaltyPayoutDate DateTime?
  printPartner          String?
  availableOn           Json?     // Array of platform strings e.g. ["Amazon India", "Flipkart"]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tickets               Ticket[]

  @@index([authorId])
  @@index([isbn])
  @@index([status])
}

model Ticket {
  id                  String         @id @default(uuid())
  ticketNumber        String         @unique // e.g. TKT-2026-0001
  authorId            String
  author              AuthorProfile  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  bookId              String?
  book                Book?          @relation(fields: [bookId], references: [id], onDelete: SetNull)
  subject             String
  description         String         @db.Text
  category            TicketCategory @default(GENERAL_INQUIRY)
  priority            TicketPriority @default(MEDIUM)
  status              TicketStatus   @default(OPEN)

  // AI-Assisted fields
  aiClassification    TicketCategory?
  aiPriority          TicketPriority?
  aiConfidence        Float?
  aiReasoning         String?        @db.Text
  aiDraftResponse     String?        @db.Text

  // Assignment to admin
  assignedAdminId     String?
  assignedAdmin       User?          @relation("AssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  messages            TicketMessage[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([authorId])
  @@index([bookId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedAdminId])
  @@index([createdAt])
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  isInternal Boolean  @default(false) // True for admin-only internal notes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
}
